{
  "manifest_version": 3,
  "name": "Kairos Read",
  "version": "0.1.0",
  "description": "Reads articles aloud with sentence highlighting, and builds interactive 3D scenes of what they describe.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Kairos Read", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["tts", "sidePanel", "storage", "unlimitedStorage", "contextMenus", "offscreen", "nativeMessaging", "scripting", "activeTab", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-read": { "suggested_key": { "default": "Alt+R" }, "description": "Read this article / pause" },
    "stop-read": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Stop reading" },
    "next-sentence": { "suggested_key": { "default": "Alt+Period" }, "description": "Next sentence" },
    "prev-sentence": { "suggested_key": { "default": "Alt+Comma" }, "description": "Previous sentence" }
  },
  "sandbox": { "pages": ["sandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self'",
    "sandbox": "sandbox allow-scripts allow-pointer-lock; default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; worker-src blob:; frame-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
